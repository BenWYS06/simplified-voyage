KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-this-password
KEYCLOAK_HOSTNAME=http://localhost:8180
INTERNAL_API_KEY=replace-with-a-long-random-shared-secret

# Add the existing mail, SMS, and payment provider credentials used by your deployment.
MAIL_USERNAME=
MAIL_APP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# VNPay sandbox: register at https://sandbox.vnpayment.vn/devreg/ to get these two values
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# FE page VNPay redirects the browser back to ("/{bookingId}" is appended)
VNPAY_RETURN_URL=http://localhost:5173/booking-success

# Optional
TWILIO_ENABLED=false
# Only when you run a service outside Docker against a database with another password
# (defaults in config-repo: root for MySQL, postgres for PostgreSQL)
# DB_PASSWORD=
# Config Server source (defaults: this repo on GitHub, branch main)
# CONFIG_GIT_URI=https://github.com/BenWYS06/simplified-voyage
# CONFIG_GIT_LABEL=main
