{
  "realm": "ben-airline",
  "enabled": true,
  "displayName": "Ben Airline",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "roles": {
    "realm": [
      {
        "name": "ROLE_CUSTOMER",
        "description": "Airline customer"
      },
      {
        "name": "ROLE_AIRLINE_OWNER",
        "description": "Airline owner"
      },
      {
        "name": "ROLE_SYSTEM_ADMIN",
        "description": "System administrator"
      }
    ]
  },
  "clients": [
    {
      "clientId": "airline-api",
      "name": "Airline API",
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "enabled": true
    },
    {
      "clientId": "airline-frontend",
      "name": "Airline Frontend",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "basic",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "airline-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "airline-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5173/*",
        "https://ben-air.vercel.app/*",
        "https://ben-fly.vercel.app/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5173",
        "https://ben-air.vercel.app",
        "https://ben-fly.vercel.app"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ]
}
